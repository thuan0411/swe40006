@page
@model IndexModel
@{
    ViewData["Title"] = Model.PageDisplayTitle;
}

<div class="text-center mb-4">
    <h1 class="display-5">@Model.PageDisplayTitle</h1>
    <p class="text-muted">A small ASP.NET Core 8 demo app for SWE40006 Task 2 &mdash; deployed to Azure App Service.</p>
    <p class="text-muted small">Demo API key (masked, loaded from Azure App Settings / configuration): <code>@Model.ApiKeyPreview</code></p>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <form method="post" asp-page-handler="Add" class="d-flex gap-2 mb-4">
            <input type="text" name="NewTaskTitle" class="form-control" placeholder="Add a new task..." required />
            <button type="submit" class="btn btn-primary">Add</button>
        </form>

        <ul class="list-group">
            @foreach (var task in Model.Tasks)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center @(task.IsDone ? "list-group-item-light text-decoration-line-through text-muted" : "")">
                    <span>@task.Title</span>
                    <span>
                        <form method="post" asp-page-handler="Toggle" asp-route-id="@task.Id" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-success">@(task.IsDone ? "Undo" : "Done")</button>
                        </form>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@task.Id" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </span>
                </li>
            }
        </ul>
    </div>
</div>
